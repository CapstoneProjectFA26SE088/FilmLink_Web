# URL backend Spring Boot; chỉ đọc từ Next.js server, không đặt tiền tố NEXT_PUBLIC_.
FILMLINK_API_BASE_URL=http://localhost:8080

# Phải khớp JWT_REFRESH_TOKEN_TTL của backend (mặc định 7 ngày = 604800 giây).
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=604800

# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SESSION_ENCRYPTION_KEY=

# Dùng true khi chạy localhost trên Edge/Chrome để hiện Secure trong DevTools.
# Production luôn bật Secure, kể cả biến này đặt false.
AUTH_COOKIE_SECURE=true
